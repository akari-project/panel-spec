{
  "transport": "tcp",
  "security": "tls",
  "tls": {
    "sni": "edge-hk-1.example.com",
    "alpn": [
      "h2",
      "http/1.1"
    ],
    "min_version": "1.2",
    "cert_mode": "acme_http"
  },
  "padding_scheme": [
    "stop=8",
    "0=30-30",
    "1=100-400",
    "2=400-500,c,500-1000,c,500-1000,c,500-1000,c,500-1000",
    "3=9-9,500-1000",
    "4=500-1000"
  ]
}
