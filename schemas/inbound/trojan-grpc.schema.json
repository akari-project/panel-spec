{
  "$defs": {
    "grpc": {
      "additionalProperties": false,
      "properties": {
        "service_name": {
          "description": "gRPC 服务名。",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
          "type": "string"
        }
      },
      "required": [
        "service_name"
      ],
      "type": "object"
    },
    "tls": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "certificate_path"
                  ]
                },
                {
                  "required": [
                    "key_path"
                  ]
                }
              ]
            }
          },
          "if": {
            "properties": {
              "cert_mode": {
                "const": "file"
              }
            },
            "required": [
              "cert_mode"
            ]
          },
          "then": {
            "required": [
              "certificate_path",
              "key_path"
            ]
          }
        }
      ],
      "properties": {
        "alpn": {
          "description": "ALPN，按优先级排列。",
          "items": {
            "enum": [
              "h3",
              "h2",
              "http/1.1"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "cert_mode": {
          "description": "证书来源：acme_http 为 HTTP-01，acme_dns 为 DNS-01（服务商凭据随 RoutesApply 加密下发，spec/20 NODE-25），file 为节点本地文件。",
          "enum": [
            "acme_http",
            "acme_dns",
            "file"
          ]
        },
        "certificate_path": {
          "description": "cert_mode 为 file 时必填：证书链 PEM 的绝对路径。",
          "maxLength": 1024,
          "pattern": "^/",
          "type": "string"
        },
        "key_path": {
          "description": "cert_mode 为 file 时必填：私钥 PEM 的绝对路径。",
          "maxLength": 1024,
          "pattern": "^/",
          "type": "string"
        },
        "min_version": {
          "description": "最低 TLS 版本，默认 1.2。",
          "enum": [
            "1.2",
            "1.3"
          ]
        },
        "sni": {
          "description": "证书域名，同时是客户端使用的 SNI。",
          "format": "hostname",
          "maxLength": 253,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "sni",
        "cert_mode"
      ],
      "type": "object"
    }
  },
  "$id": "urn:akari-project:panel-spec:schemas:inbound:trojan-grpc",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "security": {
            "const": "none"
          }
        },
        "required": [
          "security"
        ]
      },
      "then": {
        "not": {
          "required": [
            "tls"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "security": {
            "const": "tls"
          }
        },
        "required": [
          "security"
        ]
      },
      "then": {
        "required": [
          "tls"
        ]
      }
    }
  ],
  "description": "Inbound.settings_json：protocol=trojan，transport=grpc（spec/21 AGT-13）。用户凭据不在此处，由 Credential 下发。",
  "properties": {
    "grpc": {
      "$ref": "#/$defs/grpc"
    },
    "security": {
      "description": "安全层。tls 时必须提供 tls，reality 时必须提供 reality，其余情况二者都不得出现。",
      "enum": [
        "none",
        "tls"
      ]
    },
    "tls": {
      "$ref": "#/$defs/tls"
    },
    "transport": {
      "const": "grpc",
      "description": "必填，等于本组合的传输，与 Inbound.transport 一致。数据库校验以 settings->>'transport' 为准。"
    }
  },
  "required": [
    "transport",
    "security",
    "grpc"
  ],
  "title": "Trojan over gRPC",
  "type": "object",
  "x-kernels": {
    "singbox": "stable",
    "xray": "stable"
  }
}
