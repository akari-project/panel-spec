{
  "$defs": {
    "mkcp": {
      "additionalProperties": false,
      "properties": {
        "downlink_capacity_mbps": {
          "description": "下行容量，默认 20。",
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "finalmask": {
          "additionalProperties": false,
          "description": "必填。Agent 生成 Xray-core 配置时写入 streamSettings.finalmask.udp，顺序为 [header（若有）, obfs]，即包头在最外层；对照用例见 testdata/mkcp-finalmask.json。导出配置（spec/23）必须写出相同的 finalmask。finalmask 的其他 UDP 类型（header-custom、header-dns、noise、salamander、sudoku、xdns、xicmp）与 tcp、quicParams 不支持。",
          "properties": {
            "header": {
              "description": "包头伪装，取值为 Xray-core finalmask 的 UDP 类型名。省略时不加包头。header-dns、header-custom、noise 等其他 finalmask 类型不支持。旧版 mKCP 的 header.type 对应关系：srtp、utp、wechat-video、dtls、wireguard 分别对应 header-srtp、header-utp、header-wechat、header-dtls、header-wireguard。",
              "enum": [
                "header-srtp",
                "header-utp",
                "header-wechat",
                "header-dtls",
                "header-wireguard"
              ]
            },
            "obfs": {
              "additionalProperties": false,
              "allOf": [
                {
                  "else": {
                    "not": {
                      "required": [
                        "key"
                      ]
                    }
                  },
                  "if": {
                    "properties": {
                      "type": {
                        "const": "mkcp-aes128gcm"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "key"
                    ]
                  }
                }
              ],
              "description": "mKCP 数据包的校验与混淆，必填，没有隐式默认值。与旧版 mKCP 未设 seed 的行为一致时填 {\"type\": \"mkcp-original\"}。",
              "properties": {
                "key": {
                  "description": "mkcp-aes128gcm 的密码（对应 finalmask 的 settings.password，即旧版 seed），入站内全部连接共用，不是用户凭据。",
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                "type": {
                  "description": "mkcp-original 为旧版 mKCP 未设 seed 时的校验与混淆；mkcp-aes128gcm 为旧版设置 seed 时的 AES-128-GCM 加密。",
                  "enum": [
                    "mkcp-original",
                    "mkcp-aes128gcm"
                  ]
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            }
          },
          "required": [
            "obfs"
          ],
          "type": "object"
        },
        "is_congestion_enabled": {
          "description": "启用拥塞控制，默认 false。",
          "type": "boolean"
        },
        "mtu": {
          "description": "默认 1350。",
          "maximum": 1460,
          "minimum": 576,
          "type": "integer"
        },
        "read_buffer_mb": {
          "description": "单连接读缓冲，单位 MiB，默认 2。",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "tti_ms": {
          "description": "传输时间间隔，默认 50。",
          "maximum": 100,
          "minimum": 10,
          "type": "integer"
        },
        "uplink_capacity_mbps": {
          "description": "上行容量，默认 5。",
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "write_buffer_mb": {
          "description": "单连接写缓冲，单位 MiB，默认 2。",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "finalmask"
      ],
      "type": "object"
    }
  },
  "$id": "urn:akari-project:panel-spec:schemas:inbound:vless-mkcp",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Inbound.settings_json：protocol=vless，transport=mkcp（spec/21 AGT-13）。用户凭据不在此处，由 Credential 下发。",
  "properties": {
    "mkcp": {
      "$ref": "#/$defs/mkcp"
    },
    "transport": {
      "const": "mkcp",
      "description": "必填，等于本组合的传输，与 Inbound.transport 一致。数据库校验以 settings->>'transport' 为准。"
    }
  },
  "required": [
    "transport",
    "mkcp"
  ],
  "title": "VLESS over mKCP",
  "type": "object",
  "x-kernels": {
    "singbox": "unsupported",
    "xray": "stable"
  }
}
