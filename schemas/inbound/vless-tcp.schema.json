{
  "$defs": {
    "reality": {
      "additionalProperties": false,
      "properties": {
        "handshake_address": {
          "description": "握手目标站点的域名。",
          "format": "hostname",
          "maxLength": 253,
          "minLength": 1,
          "type": "string"
        },
        "handshake_port": {
          "description": "握手目标站点的端口，通常为 443。",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "max_time_difference_ms": {
          "description": "允许的客户端时钟偏差，0 表示不检查。默认 0。",
          "maximum": 3600000,
          "minimum": 0,
          "type": "integer"
        },
        "private_key": {
          "description": "X25519 私钥，base64url 无填充。由控制面生成（spec/20 NODE-04），按 CONV-19 加密保存。",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "public_key": {
          "description": "与 private_key 对应的公钥，供导出配置使用；Agent 忽略此字段。",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "short_ids": {
          "description": "短 ID，每项为 0 到 16 位偶数长度的小写十六进制。",
          "items": {
            "pattern": "^([0-9a-f]{2}){0,8}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "sni_names": {
          "description": "允许的客户端 SNI，必须是握手目标站点证书覆盖的域名。",
          "items": {
            "format": "hostname",
            "maxLength": 253,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "private_key",
        "short_ids",
        "handshake_address",
        "handshake_port",
        "sni_names"
      ],
      "type": "object"
    },
    "tls": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "certificate_path"
                  ]
                },
                {
                  "required": [
                    "key_path"
                  ]
                }
              ]
            }
          },
          "if": {
            "properties": {
              "cert_mode": {
                "const": "file"
              }
            },
            "required": [
              "cert_mode"
            ]
          },
          "then": {
            "required": [
              "certificate_path",
              "key_path"
            ]
          }
        }
      ],
      "properties": {
        "alpn": {
          "description": "ALPN，按优先级排列。",
          "items": {
            "enum": [
              "h3",
              "h2",
              "http/1.1"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "cert_mode": {
          "description": "证书来源：acme_http 为 HTTP-01，acme_dns 为 DNS-01（服务商凭据随 RoutesApply 加密下发，spec/20 NODE-25），file 为节点本地文件。",
          "enum": [
            "acme_http",
            "acme_dns",
            "file"
          ]
        },
        "certificate_path": {
          "description": "cert_mode 为 file 时必填：证书链 PEM 的绝对路径。",
          "maxLength": 1024,
          "pattern": "^/",
          "type": "string"
        },
        "key_path": {
          "description": "cert_mode 为 file 时必填：私钥 PEM 的绝对路径。",
          "maxLength": 1024,
          "pattern": "^/",
          "type": "string"
        },
        "min_version": {
          "description": "最低 TLS 版本，默认 1.2。",
          "enum": [
            "1.2",
            "1.3"
          ]
        },
        "sni": {
          "description": "证书域名，同时是客户端使用的 SNI。",
          "format": "hostname",
          "maxLength": 253,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "sni",
        "cert_mode"
      ],
      "type": "object"
    }
  },
  "$id": "urn:akari-project:panel-spec:schemas:inbound:vless-tcp",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "security": {
            "const": "none"
          }
        },
        "required": [
          "security"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "tls"
              ]
            },
            {
              "required": [
                "reality"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "security": {
            "const": "tls"
          }
        },
        "required": [
          "security"
        ]
      },
      "then": {
        "not": {
          "required": [
            "reality"
          ]
        },
        "required": [
          "tls"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "security": {
            "const": "reality"
          }
        },
        "required": [
          "security"
        ]
      },
      "then": {
        "not": {
          "required": [
            "tls"
          ]
        },
        "required": [
          "reality"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "flow": {
            "const": "xtls-rprx-vision"
          }
        },
        "required": [
          "flow"
        ]
      },
      "then": {
        "properties": {
          "security": {
            "enum": [
              "tls",
              "reality"
            ]
          }
        }
      }
    }
  ],
  "description": "Inbound.settings_json：protocol=vless，transport=tcp（spec/21 AGT-13）。用户凭据不在此处，由 Credential 下发。",
  "properties": {
    "flow": {
      "description": "下发给该入站全部凭据的流控。xtls-rprx-vision 要求 security 为 tls 或 reality。默认 none。",
      "enum": [
        "none",
        "xtls-rprx-vision"
      ]
    },
    "reality": {
      "$ref": "#/$defs/reality"
    },
    "security": {
      "description": "安全层。tls 时必须提供 tls，reality 时必须提供 reality，其余情况二者都不得出现。",
      "enum": [
        "none",
        "tls",
        "reality"
      ]
    },
    "tls": {
      "$ref": "#/$defs/tls"
    },
    "transport": {
      "const": "tcp",
      "description": "必填，等于本组合的传输，与 Inbound.transport 一致。数据库校验以 settings->>'transport' 为准。"
    }
  },
  "required": [
    "transport",
    "security"
  ],
  "title": "VLESS over TCP",
  "type": "object",
  "x-kernels": {
    "singbox": "stable",
    "xray": "stable"
  }
}
